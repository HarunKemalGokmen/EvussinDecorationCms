<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Site.master.cs" Inherits="Site" %>
<!DOCTYPE html>
<html lang="tr">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">Evussin Decoration</asp:ContentPlaceHolder></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        :root {
            --primary-color: #1a365d;
            --accent-color: #dd6b20;
        }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .bg-primary-custom { background-color: var(--primary-color) !important; }
        .text-primary-custom { color: var(--primary-color) !important; }
        .bg-accent { background-color: var(--accent-color) !important; color: white; }
        .text-accent { color: var(--accent-color) !important; }
        .btn-accent { background-color: var(--accent-color); color: white; border: none; }
        .btn-accent:hover { background-color: #c05615; color: white; }
        .navbar-brand { font-weight: bold; font-size: 1.5rem; }
        .nav-link { color: rgba(255,255,255,0.9) !important; }
        .nav-link:hover { color: var(--accent-color) !important; }
        footer { background-color: var(--primary-color); color: white; padding: 2rem 0; margin-top: 3rem; }
    </style>
    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <nav class="navbar navbar-expand-lg bg-primary-custom" data-bs-theme="dark">
          <div class="container">
            <a class="navbar-brand" href="Default.aspx"><span class="text-accent">Evussin</span> Decoration</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
              <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
              <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link" href="Default.aspx">Ana Sayfa</a></li>
                <li class="nav-item"><a class="nav-link" href="Hakkimizda.aspx">Hakkımızda</a></li>
                <li class="nav-item"><a class="nav-link" href="Hizmetler.aspx">Hizmetlerimiz</a></li>
                <li class="nav-item"><a class="nav-link" href="Iletisim.aspx">İletişim</a></li>
              </ul>
            </div>
          </div>
        </nav>

        <main style="min-height: 70vh;">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
        </main>

        <footer class="text-center">
            <div class="container">
                <p>&copy; <%= DateTime.Now.Year %> Evussin Decoration. Tüm Hakları Saklıdır. | <a href="Admin/Login.aspx" class="text-white-50 text-decoration-none">Yönetim Paneli</a></p>
                <p>Adres: Alkent 2000 Mah. Yiğittürk Bulvarı No:5, Büyükçekmece / İstanbul | Tel: 0212 555 55 55</p>
            </div>
        </footer>
    </form>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
